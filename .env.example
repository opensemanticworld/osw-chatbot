## General

API_SERVER=https://api.my-domain.org
UI_SERVER=https://my-domain.org
BOKEH_ALLOW_WS_ORIGIN=my-domain.org

# Origin of the wiki that embeds the chatbot iframe, exactly as the browser
# reports it in event.origin. Used both for the Content-Security-Policy
# frame-ancestors header (docker-compose.override.yml) and for validating
# postMessages. Comma separated for several wikis, "*" to accept any parent.
WIKI_SERVER=https://wiki.my-domain.org
PARENT_ORIGIN=https://wiki.my-domain.org

## Session isolation

# Sign bokeh session ids, so a client cannot pick its own id and attach to
# another user's session. Generate with: panel secret
BOKEH_SECRET_KEY="<random-secret>"
BOKEH_SIGN_SESSIONS=yes
# Signs the auth cookie. Generate with: panel secret
BOKEH_COOKIE_SECRET="<random-secret>"

# Shared with the MediaWiki Chatbot extension ($wgChatbotSecret) - it must
# match there byte for byte. The extension mints a short lived token per user
# and appends it to the iframe url; the backend verifies it. Leave empty to
# allow unauthenticated access (e.g. when running against an older version of
# the extension).
# HMAC-SHA256 key, so generate 32 random bytes and do NOT reuse the bokeh
# secrets above:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CHATBOT_SHARED_SECRET=""
CHATBOT_TOKEN_MAX_AGE=86400

## Chat history (stored in the browser, see issue #1)

HISTORY_ENABLED=true
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_BYTES=100000

# Seconds to wait for the browser to answer a client-side tool call
CLIENT_TOOL_TIMEOUT=60
# How long a call may wait once the browser reports it is showing a
# confirmation dialog - this measures the user reading it, not the browser.
CONFIRM_TIMEOUT=600

# Opening messages of a new chat. CHATBOT_INTRO is the disclaimer,
# CHATBOT_GREETING the conversational opener. Either may be set empty
# to hide it.
#CHATBOT_INTRO=
#CHATBOT_GREETING=what's on your mind?

## For structured output api

OPENAI_API_KEY="<api-key>"
# Legacy: full chat/completions url including the deployment name and an
# api-version. Only used when OPENAI_BASE_URL (below) is empty - otherwise the
# wrapper posts to OPENAI_BASE_URL/chat/completions with OPENAI_MODEL.
#OPENAI_API_ENDPOINT="https://your-deployment.openai.azure.com/openai/deployments/gpt-5-mini-2025-08-07/chat/completions?api-version=2025-04-01-preview"

## For chatbot

# openai -> OpenAI compatible surface of Microsoft Foundry
# claude -> Anthropic Messages surface of Microsoft Foundry
LLM_PROVIDER=openai

# OpenAI compatible endpoint, same one that works with
#   from openai import OpenAI
#   OpenAI(base_url=OPENAI_BASE_URL, api_key=OPENAI_API_KEY)
# No api-version needed. OPENAI_MODEL is the *deployment* name.
OPENAI_BASE_URL="https://your-resource.services.ai.azure.com/openai/v1"
OPENAI_MODEL="gpt-5-mini"

# Claude via Microsoft Foundry. Same resource key, sent as x-api-key by the
# Anthropic SDK, which appends /v1/messages to the base url.
# Deployments available in swedencentral include claude-sonnet-5,
# claude-opus-5, claude-sonnet-4-6 and claude-haiku-4-5.
ANTHROPIC_BASE_URL="https://your-resource.services.ai.azure.com/anthropic"
ANTHROPIC_API_KEY="<api-key>"
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_MAX_TOKENS=4096
# disabled | adaptive. Keep "disabled": with thinking on, the model returns a
# thinking block whose `thinking` field is empty, langchain-anthropic 0.3.17
# drops it when rebuilding the agent scratchpad, and the next request fails
# with "messages.N.content.0.thinking.thinking: Field required".
ANTHROPIC_THINKING=disabled

# Legacy Azure OpenAI endpoint - only used when OPENAI_BASE_URL is empty
AZURE_OPENAI_API_KEY="<api-key>"
AZURE_OPENAI_ENDPOINT="https://your-deployment.openai.azure.com"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_OPENAI_MODEL="gpt-5-mini-2025-08-07"

# Cache LLM responses on disk. Off by default: the cache key is
# (prompt, model), so with a shared cache one user can be served a completion
# that was generated in another user's context.
LLM_CACHE_ENABLED=false

## For web search

# whether browsers for webscraping run without display
HEADLESS = true
# Display ID if HEADLESS==false
DISPLAY=:0

## For the JupyterLite sandbox's LLM proxy (osw-llm-proxy)

# Where caddy publishes it. The sandbox is a static site and can hold no API key, so it
# talks to this instead; this holds the key and verifies the caller by the token the wiki
# mints with CHATBOT_SHARED_SECRET.
LLM_PROXY_SERVER=https://llm.example.org

# Upstream follows LLM_PROVIDER, the same switch osw_chatbot.llm reads, so a deployment
# that configured the chat assistant has already configured this:
#   LLM_PROVIDER=claude -> ANTHROPIC_BASE_URL + ANTHROPIC_API_KEY, sent as x-api-key
#   otherwise           -> OPENAI_BASE_URL + OPENAI_API_KEY, sent as Authorization: Bearer
# Override only to point the sandbox somewhere else than the chat assistant.
#LLM_PROXY_UPSTREAM_URL="https://your-foundry.services.ai.azure.com/anthropic"
#LLM_PROXY_UPSTREAM_KEY="<api-key>"
#LLM_PROXY_AUTH_HEADER=x-api-key
#LLM_PROXY_AUTH_SCHEME=

# Which signed action a caller must hold. Mirrors $wgChatbotActions on the wiki, so
# enabling the sandbox there is the single switch.
LLM_PROXY_REQUIRED_ACTION=code-sandbox

# Origins allowed to call it, comma separated. Not needed when it is path-routed under
# the wiki's own host. Never "*": this endpoint spends money against a vendor account.
#LLM_PROXY_ALLOWED_ORIGINS=https://wiki.example.org

# How long to wait for a completion. The httpx default of 5s truncates almost all of them.
LLM_PROXY_READ_TIMEOUT=600
